<Page x:Class="E_store.Views.ProductListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:E_store.Views"
      mc:Ignorable="d"
      Title="ProductListPage"
      Loaded="Page_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="0,0,1,0">
            <StackPanel Margin="20">
                <TextBlock Text="Prodavnica" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbStores" Margin="0,0,0,20"
                          DisplayMemberPath="Name" SelectedValuePath="Id"/>

                <TextBlock Text="Category" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbCategory" Margin="0,0,0,20"/>

                <TextBlock Text="Price" FontWeight="Bold" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBox x:Name="TxtPriceFrom" Width="70"/>
                    <TextBlock Text="to" VerticalAlignment="Center" Margin="8,0"/>
                    <TextBox x:Name="TxtPriceTo" Width="70"/>
                </StackPanel>

                <Button Content="Apply filter" Height="32" Click="BtnApplyFilter_Click"/>
                <Button Content="Reset filter" Height="32" Margin="0,8,0,0" Click="BtnResetFilter_Click"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ProductsList" Margin="20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#DDD" BorderThickness="1" CornerRadius="8"
                                Width="220" Margin="0,0,15,15" Padding="15">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding StoreName}" Foreground="#888" FontSize="12" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding ProductType}" Foreground="#888" FontSize="12"/>
                                <TextBlock Text="{Binding Price, StringFormat={}{0:N2} RSD}" FontWeight="Bold" Margin="0,8,0,3"/>
                                <TextBlock Text="{Binding Stock, StringFormat=Na stanju: {0}}" FontSize="11" Foreground="#666"/>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBox Text="1" Width="40" x:Name="TxtKolicina"/>
                                    <Button Content="Add to cart" Margin="8,0,0,0" Padding="8,4"
                                            Click="BtnAddToCart_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
