<Window x:Class="E_store.Views.UserMainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:E_store.Views"
        mc:Ignorable="d"
        Title="UserMainWindow" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Profile" Width="110" Height="35"
                    HorizontalAlignment="Left" Margin="15,0,0,0"
                    Click="BtnProfile_Click"/>

            <TextBox x:Name="TxtSearch" Grid.Column="1" Height="35"
                     VerticalContentAlignment="Center" Margin="15,0"
                     KeyDown="TxtSearch_KeyDown"/>

            <Button x:Name="BtnCart" Grid.Column="2" Content="Cart (0)" Width="110" Height="35"
                    HorizontalAlignment="Right" Margin="0,0,15,0"
                    Click="BtnCart_Click"/>
        </Grid>

        <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
