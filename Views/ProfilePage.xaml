<Page x:Class="E_store.Views.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:E_store.Views"
      mc:Ignorable="d"
      Title="Profile"
      Loaded="Page_Loaded">

    <StackPanel Margin="30">
        <TextBlock Text="My profile" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
        <TextBlock x:Name="LblIme" Margin="0,0,0,5"/>
        <TextBlock x:Name="LblEmail" Margin="0,0,0,5"/>
        <TextBlock x:Name="LblUsername" Margin="0,0,0,5"/>
        <TextBlock x:Name="LblAdresa" Margin="0,0,0,5"/>
        <TextBlock x:Name="LblTelephone" Margin="0,0,0,5"/>
    </StackPanel>
</Page>
