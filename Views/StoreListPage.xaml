<Page x:Class="E_store.Views.StoreListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:E_store.Views"
      mc:Ignorable="d"
      Title="StoreListPage"
      Loaded="Page_Loaded">

    <StackPanel Margin="30">
        <TextBlock Text="All stores" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <DataGrid x:Name="GridStores" AutoGenerateColumns="False" IsReadOnly="True"
                  Height="450" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="180"/>
                <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="120"/>
                <DataGridTextColumn Header="Telephone" Binding="{Binding Phone}" Width="120"/>
                <DataGridTextColumn Header="Manager" Binding="{Binding ManagerFullName}" Width="150"/>
                <DataGridTextColumn Header="IsActive" Binding="{Binding IsActive}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="LblMessage" Foreground="Red" Margin="0,15,0,0"/>
    </StackPanel>
</Page>
