<Page x:Class="E_store.Views.ManagerReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:E_store.Views"
      mc:Ignorable="d" 
      Title="Reports">

    <StackPanel Margin="30">
        <TextBlock Text="Reports for my stores" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock x:Name="LblStores" Foreground="#555" Margin="0,0,0,15" TextWrapping="Wrap"/>

        <TextBlock Text="Report type:"/>
        <StackPanel Orientation="Horizontal" Margin="0,5,0,15">
            <RadioButton x:Name="RbDaily" Content="Daily" GroupName="Period" IsChecked="True" Margin="0,0,20,0" Checked="Period_Checked"/>
            <RadioButton x:Name="RbMonthly" Content="Monthly" GroupName="Period" Margin="0,0,20,0" Checked="Period_Checked"/>
            <RadioButton x:Name="RbYearly" Content="Yearly" GroupName="Period" Checked="Period_Checked"/>
        </StackPanel>

        <TextBlock Text="Choose a date:"/>
        <DatePicker x:Name="DatePicker" Margin="0,5,0,20"/>

        <TextBlock x:Name="LblPeriodDescription" Foreground="#555" Margin="0,0,0,20"/>

        <StackPanel Orientation="Horizontal">
            <Button Content="Export as PDF" Width="150" Height="35" Margin="0,0,15,0" Click="BtnExportPdf_Click"/>
            <Button Content="Export to Excel" Width="150" Height="35" Click="BtnExportExcel_Click"/>
        </StackPanel>

        <TextBlock x:Name="LblMessage" Foreground="Red" Margin="0,15,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Page>
