<Page x:Class="E_store.Views.AddStorePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:E_store.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddStorePage"
      Loaded="Page_Loaded">

    <StackPanel Margin="30">
        <TextBlock Text="Add store" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Text="Store name:"/>
        <TextBox x:Name="TxtName" Margin="0,5,0,10"/>

        <TextBlock Text="Address:"/>
        <TextBox x:Name="TxtAddress" Margin="0,5,0,10"/>

        <TextBlock Text="Store type:"/>
        <TextBox x:Name="TxtType" Margin="0,5,0,10"/>

        <TextBlock Text="Telephone:"/>
        <TextBox x:Name="TxtPhone" Margin="0,5,0,10"/>

        <TextBlock Text="Manager:"/>
        <ComboBox x:Name="CmbManager" Margin="0,5,0,10"
                  DisplayMemberPath="DisplayText" SelectedValuePath="Id"/>

        <CheckBox x:Name="ChkActive" Content="Active store" IsChecked="True" Margin="0,10,0,10"/>

        <Button Content="Add store" Click="BtnAddStore_Click"
                Height="35" Width="180" HorizontalAlignment="Left" Margin="0,15,0,0"/>

        <TextBlock x:Name="LblMessage" Foreground="Red" Margin="0,15,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Page>
