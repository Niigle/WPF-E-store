<Window x:Class="E_store.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:E_store"
        mc:Ignorable="d"
        Title="LoginWindow" Height="350" Width="500">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="30"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="30*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Column="1" Grid.Row="2" FontSize="36"
                   Text="Login" Grid.ColumnSpan="3"
                   Margin="0,0,0,10"/>

        <TextBlock Grid.Column="1" Grid.Row="4" FontSize="24"
           Text="username:" Grid.ColumnSpan="1"
           Margin="10,10,10,15"/>

        <TextBox x:Name="usernameInput" Width="200" Height="30" Margin="10"
                 Grid.Column="2" Grid.Row="4"/>

        <TextBlock Grid.Column="1" Grid.Row="5" FontSize="24"
           Text="password:" Grid.ColumnSpan="1"
           Margin="10,10,10,15"/>

        <PasswordBox x:Name="passwordInput" Width="200" Height="30" Margin="10"
                 Grid.Column="2" Grid.Row="5" PasswordChar="$"/>

        <Button x:Name="loginButton" Content="Login" Grid.Column="1"
                Grid.Row="6" Height="30" Margin="10" Click="loginButton_Click" />

        <TextBlock x:Name="LblMessage" Foreground="Red" Margin="10,10,10,10" TextWrapping="Wrap"
                   Grid.Column="2" Grid.Row="6"/>

        <Button Content="Don't have an account? Register" Click="BtnOpenRegistrationPage_Click" Grid.Row="7"
        Grid.Column="1" Margin="10" Background="Transparent" BorderThickness="0" Foreground="Blue"/>
    </Grid>
</Window>
