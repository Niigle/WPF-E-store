<Page x:Class="E_store.Views.ManageProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:E_store.Views"
      mc:Ignorable="d" 
      Title="ManageProductsPage"
      Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">
            <TextBlock Text="Managing products" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

            <TextBlock Text="Choose a store:"/>
            <ComboBox x:Name="CmbStore" Margin="0,5,0,20"
                      DisplayMemberPath="Name" SelectedValuePath="Id"
                      SelectionChanged="CmbStore_SelectionChanged"/>

            <StackPanel x:Name="ContentPanel" Visibility="Collapsed">

                <TextBlock Text="Products from this store" FontWeight="Bold" Margin="0,10,0,10"/>

                <DataGrid x:Name="GridProducts" AutoGenerateColumns="False" CanUserAddRows="False"
                          Height="250" Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding Price}" Width="100"/>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Stock}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Content="Save changes (price/quantity)" Click="BtnSaveChanges_Click"
                        Height="35" Width="220" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                <TextBlock x:Name="LblMessage" Foreground="Green" Margin="0,0,0,20"/>

                <Separator Margin="0,10,0,20"/>

                <TextBlock Text="Add existing product to this store" FontWeight="Bold" Margin="0,0,0,10"/>

                <ComboBox x:Name="CmbExistingProduct" Margin="0,0,0,10"
                          DisplayMemberPath="Name" SelectedValuePath="Id"/>

                <TextBlock Text="Price:"/>
                <TextBox x:Name="TxtPriceExistingProduct" Margin="0,5,0,10"/>

                <TextBlock Text="Quantity:"/>
                <TextBox x:Name="TxtQuantityExisting" Margin="0,5,0,10"/>

                <Button Content="Add to store" Click="BtnAddExistingProduct_Click"
                        Height="35" Width="180" HorizontalAlignment="Left" Margin="0,0,0,10"/>

                <TextBlock x:Name="LblMessageExisting" Foreground="Red" Margin="0,0,0,20"/>

                <Separator Margin="0,10,0,20"/>

                <TextBlock Text="Create a new product" FontWeight="Bold" Margin="0,0,0,10"/>

                <TextBlock Text="name:"/>
                <TextBox x:Name="TxtNewName" Margin="0,5,0,10"/>

                <TextBlock Text="Type:"/>
                <TextBox x:Name="TxtNewType" Margin="0,5,0,10"/>

                <TextBlock Text="Description:"/>
                <TextBox x:Name="TxtNewDescription" Margin="0,5,0,10" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>

                <TextBlock Text="Barcode:"/>
                <TextBox x:Name="TxtNewBarcode" Margin="0,5,0,10"/>

                <TextBlock Text="Price:"/>
                <TextBox x:Name="TxtNewPrice" Margin="0,5,0,10"/>

                <TextBlock Text="Quantity:"/>
                <TextBox x:Name="TxtNewQuantity" Margin="0,5,0,10"/>

                <Button Content="Create product" Click="BtnCreateNewProduct_Click"
                        Height="35" Width="180" HorizontalAlignment="Left" Margin="0,10,0,0"/>

                <TextBlock x:Name="LblMessageNewProduct" Foreground="Red" Margin="0,10,0,20"/>

            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
